APP_NAME="ASFEC Certificates"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Arabic UI, Egyptian time. Faker locale drives seeded sample names.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG
APP_TIMEZONE=Africa/Cairo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# "daily" keeps LOG_DAILY_DAYS days of rotated files instead of one ever-growing laravel.log
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=certgen
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Must NOT be "sync" in production: rendering runs Chromium per certificate.
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="certificates@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Certificates
# ---------------------------------------------------------------------------

# Where batch completion reports go.
ADMIN_EMAIL=

# Private disk name (see config/filesystems.php) and how long to keep batch files.
CERT_DISK=certificates
CERT_RETENTION_DAYS=180
CERT_MAX_UPLOAD_MB=20
CERT_MAX_ROWS=5000

# Chromium rendering (spatie/browsershot). Leave empty to auto-detect node/npm
# from PATH and use the Chrome downloaded by the `puppeteer` npm package.
# Windows example: CERT_CHROME_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
CERT_NODE_BINARY=
CERT_NPM_BINARY=
CERT_CHROME_PATH=
CERT_NODE_MODULES_PATH=
CERT_RENDER_TIMEOUT=90
# Only needed when the queue worker runs as root (Docker). Keep false otherwise.
CERT_NO_SANDBOX=false
# Optional: connect to an already-running Chrome (ws://host:9222/devtools/browser/...)
CERT_REMOTE_WS=

# Signed download links in e-mails / WhatsApp expire after this many days.
CERT_LINK_TTL_DAYS=30
CERT_WHATSAPP_RATE_PER_MINUTE=20

# WhatsApp gateway (form POST: appkey, authkey, to, message, file URL).
WHATSAPP_APP_URL=
WHATSAPP_APP_KEY=
WHATSAPP_APP_SECRET=
WHATSAPP_TIMEOUT=15

# Reverse proxy in front of PHP (nginx/FastPanel): "*" or comma-separated IPs.
# Required so rate limits see the real client IP instead of 127.0.0.1.
TRUSTED_PROXIES=

# Public verification / download rate limits (per IP unless "GLOBAL").
CERT_VERIFY_PER_MINUTE=10
CERT_VERIFY_PER_HOUR=60
CERT_VERIFY_GLOBAL_PER_MINUTE=300
CERT_DOWNLOADS_PER_MINUTE=10
CERT_DOWNLOADS_PER_HOUR=60
